{
  "entities": {
    "HeroSlide": {
      "title": "HeroSlide",
      "description": "Slide item in hero carousel",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "bgImage": { "type": "string" },
        "title": { "type": "string" },
        "subtitle": { "type": "string" },
        "description": { "type": "string" },
        "badge": { "type": "string" },
        "primaryBtn": { "type": "string" },
        "secondaryBtn": { "type": "string" }
      }
    },
    "SiteContent": {
      "title": "SiteContent",
      "description": "Central school website configuration",
      "type": "object",
      "properties": {
        "heroSlides": { "type": "array" },
        "principal": { "type": "object" },
        "programs": { "type": "array" },
        "news": { "type": "array" },
        "facilities": { "type": "array" },
        "extracurriculars": { "type": "array" },
        "achievements": { "type": "array" },
        "customLogo": { "type": "string" },
        "updatedAt": { "type": "number" },
        "updatedBy": { "type": "string" }
      }
    },
    "PPDBRegistration": {
      "title": "PPDBRegistration",
      "description": "Online student registration submission",
      "type": "object",
      "properties": {
        "registrationCode": { "type": "string" },
        "candidateName": { "type": "string" },
        "originSchool": { "type": "string" },
        "nisn": { "type": "string" },
        "gender": { "type": "string" },
        "parentName": { "type": "string" },
        "parentPhone": { "type": "string" },
        "parentEmail": { "type": "string" },
        "selectedTrack": { "type": "string" },
        "notes": { "type": "string" },
        "status": { "type": "string" },
        "createdAt": { "type": "number" }
      }
    },
    "MediaAsset": {
      "title": "MediaAsset",
      "description": "Compressed media file asset stored in Firestore",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "dataUrl": { "type": "string" },
        "updatedAt": { "type": "number" }
      }
    }
  },
  "firestore": {
    "/site_content/{contentId}": {
      "schema": "SiteContent",
      "description": "Dynamic school content documents"
    },
    "/media_assets/{assetId}": {
      "schema": "MediaAsset",
      "description": "Compressed image assets for slides, principal, news and facilities"
    },
    "/ppdb_registrations/{registrationId}": {
      "schema": "PPDBRegistration",
      "description": "PPDB student admission documents"
    }
  }
}
